# Environment configuration example
# Copy this file to .env and customize.
# NEVER commit the real .env file to version control.

# Argon2id parameters (raise memory_cost for stronger security)
# ARGON2_MEMORY_COST=65536   # KiB (64 MiB default)
# ARGON2_TIME_COST=3
# ARGON2_PARALLELISM=4

# Auto-lock timeout in seconds (0 = disabled)
# DEFAULT_AUTO_LOCK_SECONDS=300

# Clipboard clear timeout in seconds (0 = disabled)
# DEFAULT_CLIPBOARD_CLEAR_SECONDS=30

# Failed login attempts before lockout
# MAX_FAILED_ATTEMPTS=5

# Lockout duration in seconds
# LOCKOUT_DURATION_SECONDS=30

# Custom data directory (default: platform data dir)
# PM_DATA_DIR=/path/to/your/vault/data

# Log level: DEBUG, INFO, WARNING, ERROR
# PM_LOG_LEVEL=INFO

# Log retention in days
# PM_LOG_RETENTION_DAYS=30
